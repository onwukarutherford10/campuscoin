FLASK_APP=wsgi:app
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=mysql+pymysql://campuscoin_app:<url-encoded-password>@localhost:3306/campuscoin?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://campuscoin_test:<url-encoded-password>@localhost:3306/campuscoin_test?charset=utf8mb4
# MYSQL_SSL_CA=/path/to/aiven-project-ca.pem
FRONTEND_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=30
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX_ATTEMPTS=10
CSV_SYNC_ROW_LIMIT=500
REPORT_SYNC_TRANSACTION_LIMIT=500
CSV_PREVIEW_TTL_HOURS=24
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=CampusCoin Admin
# ADMIN_PASSWORD must be supplied securely when running seed-admin.
